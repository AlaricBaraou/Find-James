# Copy to .env and adjust. All values are optional.

# Port the server listens on.
PORT=3000

# Where uploaded GPX files and metadata are stored.
# Use a PERSISTENT path / mounted volume in production.
# DATA_DIR=/data

# Max upload size in bytes (default 10 MB).
# MAX_FILE_BYTES=10485760

# --- Search area (default map framing) --------------------------------------
# Center the map on the actual search area. No code change needed.
# Defaults below target the Mount Hiei area near Kyoto.
# SEARCH_LAT=35.055
# SEARCH_LON=135.82
# SEARCH_ZOOM=12
# SEARCH_AREA_NAME=比叡山周辺 / Mt. Hiei area

# --- Security knobs ---------------------------------------------------------

# If set, uploaders must provide this passphrase. Leave blank for open uploads.
# Flip this on the moment you need to gate contributions — no code change needed.
# UPLOAD_PASSPHRASE=

# Required to delete tracks. If blank, deletion is disabled.
# Generate a long random value, then open the site at:  https://yoursite/#admin=THIS_TOKEN
# ADMIN_TOKEN=

# --- Sign-in (passwordless magic link) + contact ----------------------------
# Auth stays OFF (uploads open as today) until an SMTP transport is configured.
# Any provider works (Resend, Postmark, Mailgun, SendGrid, Gmail SMTP, ...).
# Format: smtp(s)://USER:PASS@HOST:PORT
# MAIL_SMTP_URL=smtps://apikey:SG.xxxxx@smtp.sendgrid.net:465
# MAIL_FROM=捜索マップ Search Map <no-reply@yourdomain>

# Public base URL used to build the magic-link (otherwise inferred from request).
# Set this in production so links point at the real domain.
# PUBLIC_URL=https://yourdomain

# Send the session cookie only over HTTPS. Set to 1 in production (or rely on
# the auto-detect when behind an HTTPS proxy).
# COOKIE_SECURE=1

# Local testing ONLY: returns the magic link in the API response so you can sign
# in without a real mailbox. NEVER set in production.
# AUTH_DEV_ECHO=1

# Optional anonymous group-chat link for real-time coordination (e.g. a LINE
# OpenChat invite). Shown as a button in the UI when set.
# GROUP_CHAT_URL=https://line.me/ti/g2/XXXXXXXX
