# Copy to .env and adjust. All values are optional.

# Port the server listens on.
PORT=3000

# Where uploaded GPX files and metadata are stored.
# Use a PERSISTENT path / mounted volume in production.
# DATA_DIR=/data

# Max upload size in bytes (default 10 MB).
# MAX_FILE_BYTES=10485760

# --- Search area (default map framing) --------------------------------------
# Center the map on the actual search area. No code change needed.
# SEARCH_LAT=35.0116
# SEARCH_LON=135.7681
# SEARCH_ZOOM=13
# SEARCH_AREA_NAME=○○山 周辺 / Mt. ___ area

# --- Security knobs ---------------------------------------------------------

# If set, uploaders must provide this passphrase. Leave blank for open uploads.
# Flip this on the moment you need to gate contributions — no code change needed.
# UPLOAD_PASSPHRASE=

# Required to delete tracks. If blank, deletion is disabled.
# Generate a long random value, then open the site at:  https://yoursite/#admin=THIS_TOKEN
# ADMIN_TOKEN=
